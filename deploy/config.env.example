# 简幻欢自动读取 SERVER_PORT；本项作为其他环境的备用端口。
NIGHTSTUD_PORT=17266

# 使用注册 / 密码 / Steam 授权。旧版测试口令入口默认关闭。
NIGHTSTUD_ALLOW_LEGACY_LOGIN=0
# NIGHTSTUD_ACCESS_KEY=replace-with-your-random-test-key
# 访客模式供本机测试，正式服保持关闭。
NIGHTSTUD_ALLOW_GUEST=0

# 浏览器测试大厅默认关闭；游戏客户端和 Steam 授权回调不受影响。
# 简幻欢保持 0。仅在允许网页应用的自建环境排查问题时显式设为 1。
NIGHTSTUD_WEB_TEST_UI=0

# 掉线后保留座位的秒数（3–300），默认 90。
NIGHTSTUD_RECONNECT_SECONDS=90

# 初次上传后按 DEPLOY-DNSHE.md 签发证书，finish 会写入 HTTPS 配置。
NIGHTSTUD_SCHEME=http

# 日志与 app 文件夹同级。按 UTC 日期和文件大小轮转，默认保留 14 天。
NIGHTSTUD_LOG_MAX_MB=8
NIGHTSTUD_LOG_DAYS=14
NIGHTSTUD_MEDIA_DAILY_MB=512
# 数据位于包根目录 data，更新时保留；也可设置绝对路径。
# NIGHTSTUD_DATA_DIR=/home/container/data
# 可选自定义目录；不填时使用包根目录的 logs。
# NIGHTSTUD_LOG_DIR=/home/container/logs

# 如果通过反向代理访问，填写浏览器看到的完整 origin，例如 https://牌桌域名。
# NIGHTSTUD_PUBLIC_ORIGIN=https://your-server.example:{port}

# 直接 HTTPS/WSS 时启用以下证书配置，路径改为自己上传的文件。
# ASPNETCORE_Kestrel__Certificates__Default__Path=/path/to/server.pfx
# NIGHTSTUD_CERT_PASSWORD_FILE=/home/container/data/certificates/password.txt
